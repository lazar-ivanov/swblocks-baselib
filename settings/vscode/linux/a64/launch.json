    //
    // "args": [ "http", "request", "-s", "-h", "en.wikipedia.org", "--path", "/wiki/Probability_theory" ],
    //
    "version": "0.2.0",
    "configurations": [
        {
            "name": "(lldb) Launch bl-tool (debug)",
            "type": "lldb",
            "request": "launch",
            "program": "${workspaceFolder}/bld/ub24-a64-clang2010-debug/apps/bl-tool/bl-tool",
            "args": [ "http", "request", "-s", "-h", "en.wikipedia.org", "--path", "/wiki/Probability_theory" ],
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "(lldb) Launch bl-tool (release)",
            "type": "lldb",
            "request": "launch",
            "program": "${workspaceFolder}/bld/ub24-a64-clang2010-release/apps/bl-tool/bl-tool",
            "args": [ "http", "request", "-s", "-h", "en.wikipedia.org", "--path", "/wiki/Probability_theory" ],
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "(lldb) Launch utf-baselib (debug)",
            "type": "lldb",
            "request": "launch",
            "program": "${workspaceFolder}/bld/ub24-a64-clang2010-debug/utests/utf_baselib/utf-baselib",
            "args": [ "--log_level=message", "--run_test=BaseLib_URIEncodeDecodeTests" ],
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "(lldb) Launch utf-baselib-tasks (debug)",
            "type": "lldb",
            "request": "launch",
            "program": "${workspaceFolder}/bld/ub24-a64-clang2010-debug/utests/utf_baselib_tasks/utf-baselib-tasks",
            "args": [ "--log_level=message", "--run_test=Tasks_PingerAutoAddInvalidHostTests", "--", "--bl-logging-level=6"],
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "(lldb) Launch utf-baselib-jni (debug)",
            "type": "lldb",
            "request": "launch",
            "program": "${workspaceFolder}/bld/ub24-a64-clang2010-debug/utests/utf_baselib_jni/utf-baselib-jni",
            "args": [ "--log_level=message", "--run_test=Jni_CreateJniEnvironments" ],
            "env": {
                "JAVA_HOME" : "${env:HOME}/swblocks/dist-devenv7-ub24-gcc1520-clang2010-a64/openjdk/25/a64"
            },
            "cwd": "${workspaceFolder}"
        }
    ]
}
