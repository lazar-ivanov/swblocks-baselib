[run]
source = ../
concurrency = multiprocessing
sigterm = true
# Omit patterns:
# - Test files, cache directories, hidden files (standard exclusions)
# - generate-eclipse-project-config.py: Small utility script, not critical for development
# - clang-cl.py: Identical copy of cl.py (only differs by script name), fully tested via cl.py
omit =
    */tests/*
    */__pycache__/*
    */.*
    *generate-eclipse-project-config.py
    *clang-cl.py

[report]
precision = 2
show_missing = True
skip_covered = False
# Coverage failure threshold
fail_under = 80.0

[html]
directory = htmlcov
